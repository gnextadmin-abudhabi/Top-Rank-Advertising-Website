# Copy this file to `.env` and fill in the value below.
# `.env` is gitignored; `.env.example` is committed as documentation.

# Contact-form endpoint (src/pages/contact.astro).
# Get a free access key at https://web3forms.com — enter the address that should
# receive enquiries and they email you the key. Paste it here.
#
# Until this is set the form still renders and validates client-side, but
# Web3Forms will reject the submission, so enquiries will NOT reach the inbox.
PUBLIC_WEB3FORMS_ACCESS_KEY=
