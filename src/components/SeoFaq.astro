---
import { Icon } from 'astro-icon/components';
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { generateFaqs } from '../data/seoContent';
import Reveal from './ui/Reveal.astro';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

const faqs = generateFaqs(area, service);

const heading = service
  ? `Frequently Asked Questions about ${service.name} in ${area.name}`
  : `Frequently Asked Questions about Printing & Branding in ${area.name}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<section class="mx-auto max-w-5xl px-5 py-16 sm:px-6 md:px-8 md:py-20">
  <Reveal variant="up">
    <span
      class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-700 ring-1 ring-brand-500/20"
    >
      <span class="size-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
      FAQ
    </span>
  </Reveal>
  <Reveal variant="up" delay={90}>
    <h2 class="mt-5 font-display text-3xl leading-[1.12] tracking-tight text-brand-900 sm:text-4xl">
      {heading}
    </h2>
  </Reveal>

  <div class="mt-10 space-y-3">
    {
      faqs.map((faq, i) => (
        <Reveal variant="up" delay={Math.min(i, 5) * 70}>
          {/* Native <details> on purpose: the answers must stay in the DOM and
              crawlable so the page matches its FAQPage schema. */}
          <details class="group overflow-hidden rounded-2xl border border-stone-200 bg-white transition-colors duration-300 hover:border-brand-200 open:border-brand-200 open:shadow-brand-sm">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 text-base font-semibold text-brand-900 sm:px-7 sm:text-lg [&::-webkit-details-marker]:hidden [&::marker]:hidden">
              <span>{faq.question}</span>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 transition-all duration-300 group-hover:bg-brand-100 group-open:bg-accent-500 group-open:text-white">
                <Icon
                  name="lucide:chevron-down"
                  class="size-4 transition-transform duration-300 group-open:rotate-180"
                />
              </span>
            </summary>
            <div class="border-t border-stone-100 px-5 pb-5 pt-4 text-[0.9375rem] leading-relaxed text-stone-600 sm:px-7">
              {faq.answer}
            </div>
          </details>
        </Reveal>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
