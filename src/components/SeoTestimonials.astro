---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { getReviewsForPage, reviews } from '../data/seoContent';
import { Icon } from 'astro-icon/components';

interface Props {
  area: ServiceArea;
  service?: ServiceType;
}

const { area, service } = Astro.props;

const pageReviews = getReviewsForPage(area.slug, service?.slug, 3);

const avgRating =
  reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length;

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Top Rank Advertising',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avgRating.toFixed(1),
    bestRating: '5',
    worstRating: '1',
    reviewCount: reviews.length,
  },
  review: pageReviews.map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Organization', name: r.author },
    datePublished: r.date,
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
  })),
};

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<section class="mt-16">
  <h2 class="font-display text-3xl leading-[1.12] tracking-tight text-brand-900 sm:text-4xl">
    What Our Clients Say
  </h2>

  <div class="mt-4 flex items-center gap-2">
    <div class="flex items-center gap-0.5">
      {Array.from({ length: 5 }).map((_, i) => (
        <Icon
          name="lucide:star"
          class:list={[
            'size-5',
            i < Math.round(avgRating)
              ? 'fill-amber-400 text-amber-400'
              : 'fill-stone-200 text-stone-200',
          ]}
        />
      ))}
    </div>
    <span class="text-sm font-semibold text-brand-900">
      {avgRating.toFixed(1)} out of 5
    </span>
    <span class="text-sm text-stone-500">
      based on {reviews.length} reviews
    </span>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 md:grid-cols-3">
    {pageReviews.map((review) => {
      const fullStars = Math.floor(review.rating);
      return (
        <figure class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-400 ease-out-expo hover:-translate-y-1 hover:shadow-brand-md">
          <div class="flex items-center gap-0.5">
            {Array.from({ length: 5 }).map((_, i) => (
              <Icon
                name="lucide:star"
                class:list={[
                  'size-4',
                  i < fullStars
                    ? 'fill-amber-400 text-amber-400'
                    : 'fill-stone-200 text-stone-200',
                ]}
              />
            ))}
          </div>

          <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-stone-600">
            &ldquo;{review.text}&rdquo;
          </blockquote>

          <figcaption class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4">
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-50 font-display text-base text-brand-700"
              aria-hidden="true"
            >
              {review.author.charAt(0)}
            </span>
            <span>
              <span class="block text-sm font-semibold text-brand-900">{review.author}</span>
              <span class="block text-xs text-stone-500">{formatDate(review.date)}</span>
            </span>
          </figcaption>
        </figure>
      );
    })}
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />
