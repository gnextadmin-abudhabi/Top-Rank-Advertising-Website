---
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { serviceUrl, areaUrl } from '../lib/urls';
import Reveal from './ui/Reveal.astro';

const companyLinks = [
  { href: '/about/', label: 'About Us' },
  { href: '/services/', label: 'All Services' },
  { href: '/areas/', label: 'All Service Areas' },
  { href: '/blog/', label: 'Insights' },
  { href: '/contact/', label: 'Contact' },
];
---

<footer class="on-dark bg-brand-950 text-white">
  <!-- Hairline wipes in once the footer enters the viewport. -->
  <Reveal variant="fade">
    <div
      class="hairline h-px w-full bg-gradient-to-r from-transparent via-brand-500/60 to-transparent"
    >
    </div>
  </Reveal>

  <div class="mx-auto max-w-site px-5 pb-10 pt-16 sm:px-6 md:px-8 md:pt-20">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <!-- Brand -->
      <Reveal variant="up" class="md:col-span-12 lg:col-span-4">
        <a href="/" class="group inline-flex items-center gap-2.5">
          <img
            src="/images/logo.png"
            alt="Top Rank Advertising & Designing LLC"
            class="h-10 w-auto transition-transform duration-400 ease-out-expo group-hover:scale-[1.03]"
            width="588"
            height="244"
            loading="lazy"
          />
        </a>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-stone-400">
          {business.tagline} B2B printing, branding, and acrylic fabrication for businesses across
          Abu Dhabi and Al Ain.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-4 py-2 text-sm font-semibold text-white transition-colors duration-300 hover:bg-accent-600"
          >
            <Icon name="lucide:message-circle" class="size-4" />
            WhatsApp
          </a>
          <a
            href={business.phoneHref}
            class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white ring-1 ring-white/15 transition-colors duration-300 hover:bg-white/20"
          >
            <Icon name="lucide:phone" class="size-4" />
            {business.phone}
          </a>
        </div>
      </Reveal>

      <!-- Services -->
      <Reveal variant="up" delay={80} class="md:col-span-6 lg:col-span-3">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
          Our Services
        </h3>
        <ul class="mt-5 space-y-2.5">
          {
            serviceTypes.map((service) => (
              <li>
                <a
                  href={serviceUrl(service.slug)}
                  class="group inline-flex items-center gap-2 text-sm text-stone-400 transition-colors duration-300 hover:text-white"
                >
                  <span class="h-px w-0 bg-accent-500 transition-all duration-300 ease-out-expo group-hover:w-3" />
                  {service.name}
                </a>
              </li>
            ))
          }
        </ul>
      </Reveal>

      <!-- Areas -->
      <Reveal variant="up" delay={160} class="md:col-span-6 lg:col-span-3">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
          Service Areas
        </h3>
        <ul class="mt-5 space-y-2.5">
          {
            serviceAreas.map((area) => (
              <li>
                <a
                  href={areaUrl(area.slug)}
                  class="group inline-flex items-center gap-2 text-sm text-stone-400 transition-colors duration-300 hover:text-white"
                >
                  <span class="h-px w-0 bg-accent-500 transition-all duration-300 ease-out-expo group-hover:w-3" />
                  {area.name}
                </a>
              </li>
            ))
          }
        </ul>
      </Reveal>

      <!-- Contact -->
      <Reveal variant="up" delay={240} class="md:col-span-12 lg:col-span-2">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
          Contact Info
        </h3>
        <ul class="mt-5 space-y-3">
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:map-pin" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <span class="text-sm text-stone-400">
              {business.address.street}, {business.address.city}, {business.address.state}
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <a
              href={business.phoneHref}
              class="text-sm text-stone-400 transition-colors hover:text-white"
            >
              {business.phone}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:phone" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <a
              href={business.landlineHref}
              class="text-sm text-stone-400 transition-colors hover:text-white"
            >
              {business.landline}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:message-circle" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <a
              href={business.whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-stone-400 transition-colors hover:text-white"
            >
              WhatsApp {business.whatsapp}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:mail" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <a
              href={`mailto:${business.email}`}
              class="text-sm text-stone-400 transition-colors hover:text-white"
            >
              {business.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:clock" class="mt-0.5 size-4 shrink-0 text-accent-500" />
            <div class="text-sm text-stone-400">
              {
                business.hours.map((schedule) => (
                  <p>
                    {schedule.days}: {schedule.hours}
                  </p>
                ))
              }
            </div>
          </li>
        </ul>
      </Reveal>
    </div>

    <!-- Company nav + map -->
    <div class="mt-12 grid gap-8 border-t border-white/10 pt-10 md:grid-cols-12">
      <Reveal variant="up" class="md:col-span-5">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
          Company
        </h3>
        <ul class="mt-5 grid grid-cols-2 gap-2.5">
          {
            companyLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group inline-flex items-center gap-2 text-sm text-stone-400 transition-colors duration-300 hover:text-white"
                >
                  <span class="h-px w-0 bg-accent-500 transition-all duration-300 ease-out-expo group-hover:w-3" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </Reveal>

      <Reveal variant="up" delay={100} class="md:col-span-7">
        <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
          Find Us
        </h3>
        <div class="mt-5 overflow-hidden rounded-2xl border border-white/10">
          <iframe
            title="Top Rank Advertising location on Google Maps"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3631.5584!2d54.5369!3d24.3683!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDIyJzA1LjkiTiA1NMKwMzInMTIuOCJF!5e0!3m2!1sen!2sae!4v1694784000000!5m2!1sen!2sae"
            width="100%"
            height="220"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </Reveal>
    </div>

    <!-- Bottom bar -->
    <div
      class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 sm:flex-row"
    >
      <p class="text-xs text-stone-600">
        &copy; {new Date().getFullYear()} {business.legalName}. All rights reserved.
      </p>
      <p class="text-xs text-stone-600">
        B2B printing & branding. Abu Dhabi & Al Ain. Powered by <a
          href="https://gxlocate.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-stone-500 transition-colors hover:text-white">gxlocate.com</a
        >
      </p>
    </div>
  </div>
</footer>
