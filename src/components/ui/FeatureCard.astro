---
import { Icon } from 'astro-icon/components';
import Reveal from './Reveal.astro';

interface Props {
  icon: string;
  title: string;
  detail?: string;
  tone?: 'light' | 'dark';
  align?: 'left' | 'center';
  variant?: 'card' | 'bare';
  delay?: number;
  class?: string;
}

const {
  icon,
  title,
  detail,
  tone = 'light',
  align = 'left',
  variant = 'card',
  delay = 0,
  class: className,
} = Astro.props;

const isDark = tone === 'dark';
const isCard = variant === 'card';
---

<Reveal variant="up" delay={delay} class={className}>
  <div
    class={[
      'group flex h-full flex-col',
      align === 'center' ? 'items-center text-center' : 'items-start',
      isCard
        ? isDark
          ? 'rounded-2xl bg-white/5 p-6 ring-1 ring-white/10 transition-colors duration-300 hover:bg-white/10'
          : 'rounded-2xl border border-stone-200 bg-white p-6 transition-all duration-400 ease-out-expo hover:-translate-y-1 hover:shadow-brand-md'
        : '',
    ]
      .filter(Boolean)
      .join(' ')}
  >
    <div
      class={[
        'flex size-12 items-center justify-center rounded-xl ring-1 transition-all duration-500 ease-out-expo group-hover:scale-105',
        isDark
          ? 'bg-accent-500/15 text-accent-400 ring-accent-500/30'
          : 'bg-brand-50 text-brand-700 ring-brand-500/20',
      ].join(' ')}
    >
      <Icon name={icon} class="size-6" />
    </div>
    <h3
      class={`mt-4 font-display text-lg tracking-tight md:text-xl ${isDark ? 'text-white' : 'text-brand-900'}`}
    >
      {title}
    </h3>
    {
      detail && (
        <p
          class={`mt-2 text-sm leading-relaxed ${isDark ? 'text-brand-200' : 'text-stone-600'}`}
        >
          {detail}
        </p>
      )
    }
  </div>
</Reveal>
