---
import type { HTMLAttributes } from 'astro/types';

/**
 * Infinite scrolling strip. The track is rendered twice — the clone is
 * aria-hidden + inert — so the -50% translate loops seamlessly.
 *
 * Deliberately NOT links: the same names are clickable in the grid below, and
 * moving link targets are a usability failure.
 */
interface Props extends HTMLAttributes<'div'> {
  items: string[];
  speed?: 'normal' | 'slow';
  label: string;
}

const { items, speed = 'normal', label, ...rest } = Astro.props;
const animation = speed === 'slow' ? 'animate-marquee-slow' : 'animate-marquee';
---

<div class="marquee" role="group" aria-label={label} {...rest}>
  <div class={`marquee__track ${animation}`}>
    {
      [0, 1].map((copy) => (
        <div class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((item) => (
            <div class="flex items-center">
              <span class="whitespace-nowrap px-5 font-display text-base tracking-tight text-brand-300 sm:text-lg md:text-xl">
                {item}
              </span>
              <span class="size-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true" />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>
