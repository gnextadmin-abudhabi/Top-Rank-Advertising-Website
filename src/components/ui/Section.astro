---
/**
 * Every section on the site goes through here. Binding backgrounds to six
 * named tones is what keeps 129 pages reading as one theme.
 *
 * Rule: no two vertically adjacent sections share a tone.
 */
interface Props {
  tone?: 'ink' | 'deep' | 'paper' | 'plain' | 'mist' | 'shade';
  size?: 'sm' | 'md' | 'lg' | 'none';
  container?: 'site' | '5xl' | '4xl' | '3xl';
  /** Skip the inner container so children can run full-bleed. */
  bleed?: boolean;
  id?: string;
  class?: string;
  containerClass?: string;
}

// Whole literal class strings only. Tailwind cannot see concatenated fragments.
const TONES = {
  ink: 'bg-brand-950 text-white',
  deep: 'bg-gradient-to-br from-brand-900 to-brand-800 text-white',
  paper: 'bg-stone-50 text-stone-900',
  plain: 'bg-white text-stone-900',
  mist: 'bg-brand-50 text-brand-900',
  shade: 'bg-stone-100 text-stone-900',
} as const;

const SIZES = {
  sm: 'py-10 sm:py-12 md:py-14 lg:py-16',
  md: 'py-14 sm:py-16 md:py-20 lg:py-24',
  lg: 'py-16 sm:py-20 md:py-24 lg:py-28',
  none: '',
} as const;

const CONTAINERS = {
  site: 'mx-auto w-full max-w-site px-5 sm:px-6 md:px-8',
  '5xl': 'mx-auto w-full max-w-5xl px-5 sm:px-6 md:px-8',
  '4xl': 'mx-auto w-full max-w-4xl px-5 sm:px-6 md:px-8',
  '3xl': 'mx-auto w-full max-w-3xl px-5 sm:px-6 md:px-8',
} as const;

const {
  tone = 'paper',
  size = 'md',
  container = 'site',
  bleed = false,
  id,
  class: className,
  containerClass,
} = Astro.props;

const isDark = tone === 'ink' || tone === 'deep';
---

<section
  id={id}
  data-tone={tone}
  class={[TONES[tone], SIZES[size], isDark ? 'on-dark' : '', className]
    .filter(Boolean)
    .join(' ')}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class={[CONTAINERS[container], containerClass].filter(Boolean).join(' ')}>
        <slot />
      </div>
    )
  }
</section>
