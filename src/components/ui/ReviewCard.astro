---
import { Icon } from 'astro-icon/components';
import type { Review } from '../../data/seoContent';
import Reveal from './Reveal.astro';

interface Props {
  review: Review;
  variant?: 'rail' | 'grid';
  delay?: number;
}

const { review, variant = 'grid', delay = 0 } = Astro.props;

const Wrapper = variant === 'rail' ? 'div' : Reveal;

const formattedDate = new Date(review.date).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
});
---

{/* A card in the horizontal rail is NOT individually revealed: cards parked
    off-screen to the right never intersect on vertical scroll, so they would
    stay at opacity 0 and the rail would look half-empty. The rail container
    carries the reveal instead. */}
<Wrapper
  {...variant === 'rail'
    ? { class: 'w-[85vw] shrink-0 snap-start sm:w-80 md:w-[22rem]' }
    : { variant: 'up', delay }}
>
  <figure class="flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-6 transition-shadow duration-400 hover:shadow-brand-md">
    <div class="flex items-center gap-0.5" aria-label={`${review.rating} out of 5 stars`}>
      {
        Array.from({ length: 5 }).map((_, i) => (
          <Icon
            name="lucide:star"
            class={
              i < review.rating
                ? 'size-4 fill-amber-400 text-amber-400'
                : 'size-4 fill-stone-200 text-stone-200'
            }
          />
        ))
      }
    </div>
    <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-stone-600">
      &ldquo;{review.text}&rdquo;
    </blockquote>
    <figcaption class="mt-5 flex items-center gap-3 border-t border-stone-100 pt-4">
      <span
        class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-50 font-display text-base text-brand-700"
        aria-hidden="true"
      >
        {review.author.charAt(0)}
      </span>
      <span>
        <span class="block text-sm font-semibold text-brand-900">{review.author}</span>
        <span class="block text-xs text-stone-500">{formattedDate}</span>
      </span>
    </figcaption>
  </figure>
</Wrapper>
