---
import { Icon } from 'astro-icon/components';
import type { ServiceArea } from '../../data/serviceAreas';
import Reveal from './Reveal.astro';

interface Props {
  area: ServiceArea;
  href: string;
  variant?: 'full' | 'compact' | 'mini' | 'wide';
  headingLevel?: 'h2' | 'h3';
  showPopulation?: boolean;
  showResponseTime?: boolean;
  showPriority?: boolean;
  showDescription?: boolean;
  /** Overrides the response-time label, e.g. "Response time: 30 minutes". */
  responseLabel?: string;
  /** Renders population as a plain "Population: n" line instead of icon + n. */
  populationLabel?: boolean;
  delay?: number;
}

const PRIORITY_BADGES = {
  primary: 'bg-accent-50 text-accent-700 ring-1 ring-accent-500/20',
  secondary: 'bg-brand-50 text-brand-700 ring-1 ring-brand-500/20',
  tertiary: 'bg-stone-100 text-stone-600 ring-1 ring-stone-200',
} as const;

const {
  area,
  href,
  variant = 'compact',
  headingLevel: Heading = 'h3',
  showPopulation = false,
  showResponseTime = true,
  showPriority = false,
  showDescription = false,
  responseLabel,
  populationLabel = false,
  delay = 0,
} = Astro.props;

const isMini = variant === 'mini';
const isWide = variant === 'wide';
---

<Reveal variant="up" delay={delay} class={isWide ? 'sm:col-span-2' : ''}>
  <a
    href={href}
    class="group flex h-full flex-col rounded-2xl border border-stone-200 bg-white p-5 transition-all duration-400 ease-out-expo hover:-translate-y-1 hover:border-brand-200 hover:shadow-brand-md"
  >
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-start gap-2.5">
        <Icon
          name="lucide:map-pin"
          class="mt-0.5 size-4 shrink-0 text-accent-500 transition-transform duration-300 group-hover:-translate-y-0.5"
        />
        <div>
          <Heading class="font-display text-lg tracking-tight text-brand-900">
            {area.name}
          </Heading>
          <p class="mt-0.5 text-xs text-stone-500">{area.county}</p>
        </div>
      </div>
      {
        showPriority && (
          <span
            class={`shrink-0 rounded-full px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider ${PRIORITY_BADGES[area.priority]}`}
          >
            {area.priority}
          </span>
        )
      }
    </div>

    {
      showDescription && (
        <p class="mt-3 line-clamp-2 flex-1 text-sm leading-relaxed text-stone-600">
          {area.description}
        </p>
      )
    }

    {
      (showPopulation || showResponseTime) && !isMini && (
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-stone-500">
          {showPopulation &&
            (populationLabel ? (
              <span>Population: {area.population.toLocaleString()}</span>
            ) : (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="lucide:users" class="size-3.5" />
                {area.population.toLocaleString()}
              </span>
            ))}
          {showResponseTime && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="lucide:clock" class="size-3.5" />
              {responseLabel ?? `${area.responseTime} response`}
            </span>
          )}
        </div>
      )
    }
  </a>
</Reveal>
