---
import { Icon } from 'astro-icon/components';
import type { ServiceType } from '../../data/serviceTypes';
import MediaFrame from './MediaFrame.astro';
import Reveal from './Reveal.astro';

interface Props {
  service: ServiceType;
  href: string;
  /**
   * photo   = image on top, icon badge inside the image
   * wide    = image left / text right, spans 2 columns (row-filler + variety)
   * compact = dense text row, no photo (area pages list all 10)
   */
  variant?: 'photo' | 'wide' | 'compact';
  /**
   * services/index.astro and areas/index.astro use <h2> for card titles while
   * the homepage uses <h3>. Hardcoding one level would silently rewrite the
   * heading outline on those pages.
   */
  headingLevel?: 'h2' | 'h3';
  /** 'from' = From AED x | 'range' = From/Up to | 'minmax' = AED x - AED y */
  price?: 'from' | 'range' | 'minmax' | 'none';
  delay?: number;
}

const {
  service,
  href,
  variant = 'photo',
  headingLevel: Heading = 'h3',
  price = 'from',
  delay = 0,
} = Astro.props;

const isWide = variant === 'wide';
const isCompact = variant === 'compact';
const hasMedia = !isCompact;
---

<Reveal variant="up" delay={delay} class={isWide ? 'lg:col-span-2' : ''}>
  <a
    href={href}
    class={[
      'group relative flex h-full overflow-hidden rounded-2xl border border-stone-200 bg-white transition-all duration-400 ease-out-expo hover:-translate-y-1.5 hover:border-brand-200 hover:shadow-brand-md',
      isWide ? 'flex-col lg:flex-row' : 'flex-col',
    ].join(' ')}
  >
    {
      hasMedia && (
        <div class={isWide ? 'relative lg:w-5/12 lg:shrink-0' : 'relative'}>
          <MediaFrame
            src={service.image}
            alt={`${service.name} by Top Rank Advertising`}
            ratio={isWide ? '4/3' : '16/9'}
            rounded="none"
            zoom
            sizes={
              isWide
                ? '(min-width: 1024px) 25vw, (min-width: 640px) 20vw, 100vw'
                : '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'
            }
            class={isWide ? 'lg:h-full lg:aspect-auto' : ''}
          />
          {/* Badge sits inside the frame, so nothing can clip it. */}
          <span class="absolute left-4 top-4 flex size-11 items-center justify-center rounded-xl bg-white/95 text-brand-700 shadow-brand-sm backdrop-blur-sm transition-colors duration-300 group-hover:bg-accent-500 group-hover:text-white">
            <Icon name={service.icon} class="size-5" />
          </span>
        </div>
      )
    }

    <div class={isCompact ? 'flex flex-1 flex-col p-5' : 'flex flex-1 flex-col p-6'}>
      {
        isCompact && (
          <div class="flex size-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition-colors duration-300 group-hover:bg-brand-100">
            <Icon name={service.icon} class="size-6" />
          </div>
        )
      }

      <Heading
        class={[
          'font-display tracking-tight text-brand-900',
          isWide ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
          isCompact ? 'mt-4' : '',
        ]
          .filter(Boolean)
          .join(' ')}
      >
        {service.name}
      </Heading>

      <p class="mb-5 mt-2 text-sm leading-relaxed text-stone-600">
        {service.shortDescription}
      </p>

      <div
        class="mt-auto flex items-center justify-between gap-3 border-t border-stone-100 pt-4"
      >
        <div class="text-sm font-semibold text-brand-700">
          {price === 'from' && <span>From AED {service.priceRange.min.toLocaleString()}</span>}
          {
            price === 'minmax' && (
              <span>
                AED {service.priceRange.min.toLocaleString()} - AED{' '}
                {service.priceRange.max.toLocaleString()}
              </span>
            )
          }
          {
            price === 'range' && (
              <span>
                From AED {service.priceRange.min.toLocaleString()}
                <span class="mt-0.5 block text-xs font-medium text-stone-500">
                  Up to AED {service.priceRange.max.toLocaleString()}
                </span>
              </span>
            )
          }
        </div>
        <span
          class="btn-arrow__circle flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 transition-colors duration-300 group-hover:bg-accent-500 group-hover:text-white"
          aria-hidden="true"
        >
          <Icon name="lucide:arrow-right" class="size-4" />
        </span>
      </div>
    </div>
  </a>
</Reveal>
