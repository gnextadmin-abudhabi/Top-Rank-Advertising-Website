---
import type { ServiceArea } from '../data/serviceAreas';
import type { ServiceType } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';
import { comboUrl, areaUrl } from '../lib/urls';

interface Props {
  currentArea: ServiceArea;
  service?: ServiceType;
}

const { currentArea, service } = Astro.props;

const otherAreas = serviceAreas.filter((a) => a.slug !== currentArea.slug);
---

<section class="mt-12">
  <h3 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-500">
    {service
      ? `${service.name} in other areas`
      : 'Other areas we serve'}
  </h3>

  <div class="mt-5 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
    {otherAreas.map((area) => (
      <a
        href={service ? comboUrl(area.slug, service.slug) : areaUrl(area.slug)}
        class="group rounded-2xl border border-stone-200 bg-white p-5 transition-all duration-400 ease-out-expo hover:-translate-y-1 hover:border-brand-200 hover:shadow-brand-md"
      >
        <span class="font-display text-lg tracking-tight text-brand-900">
          {area.name}
        </span>
        <p class="mt-1 text-sm text-stone-500">
          {area.county}
        </p>
      </a>
    ))}
  </div>
</section>
