---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { business } from '../../data/business';
import { serviceAreas } from '../../data/serviceAreas';
import { areaUrl, contactUrl } from '../../lib/urls';

import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import AreaCard from '../../components/ui/AreaCard.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const areasSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Service Areas',
  description: `${business.name} serves businesses across Abu Dhabi and Al Ain.`,
  itemListElement: serviceAreas.map((area, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: area.name,
    description: area.description,
    url: `${business.website}${areaUrl(area.slug)}`,
  })),
};
---

<BaseLayout
  title={`Service Areas | ${business.name}`}
  description={`${business.name} serves businesses across Abu Dhabi and Al Ain. See our service areas, response times, and coverage for your location.`}
  schema={areasSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Service Areas' }]} />

  <!-- ============ HEADER ============ -->
  <Section tone="paper" size="sm">
    <SectionHeading
      eyebrow="Coverage"
      title="Areas We Serve"
      as="h1"
      size="page"
      align="left"
      max="max-w-3xl"
      subcopy={`Based in Mussafah, ${business.name} provides reliable B2B printing and branding services throughout Abu Dhabi and Al Ain. We know these communities because we are part of them, and we are committed to fast response times no matter where your business is located.`}
    />
  </Section>

  <!-- ============ AREAS GRID ============ -->
  <Section tone="plain" size="lg">
    <!-- headingLevel stays h2: these card titles are this page's outline. -->
    <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        serviceAreas.map((area, i) => (
          <AreaCard
            area={area}
            href={areaUrl(area.slug)}
            variant={area.priority === 'primary' ? 'wide' : 'full'}
            headingLevel="h2"
            showPopulation
            showPriority
            showDescription
            responseLabel={area.responseTime}
            delay={Math.min(i, 5) * 70}
          />
        ))
      }
    </div>
  </Section>

  <!-- ============ CTA ============ -->
  <Section tone="deep" size="md">
    <CtaBanner
      title="Not Sure If We Cover Your Area?"
      body="Get in touch. If you are anywhere in Abu Dhabi or Al Ain, we can deliver to your location."
      primary={{
        label: 'WhatsApp',
        href: business.whatsappHref,
        icon: 'lucide:message-circle',
        external: true,
      }}
      secondary={{ label: 'Contact Us', href: contactUrl() }}
    />
  </Section>
</BaseLayout>
