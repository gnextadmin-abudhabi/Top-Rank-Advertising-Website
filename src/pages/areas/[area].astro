---
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceAreas, getAreaBySlug, getNearbyAreas } from '../../data/serviceAreas';
import { serviceUrl, areaUrl, comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';
import SeoTestimonials from '../../components/SeoTestimonials.astro';

import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Pill from '../../components/ui/Pill.astro';
import StatCounter from '../../components/ui/StatCounter.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import AreaCard from '../../components/ui/AreaCard.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

import type { ServiceArea } from '../../data/serviceAreas';

export function getStaticPaths() {
  return serviceAreas.map((area) => ({
    params: { area: area.slug },
    props: { area },
  }));
}

interface Props {
  area: ServiceArea;
}

const { area } = Astro.props;

const nearbyAreas = getNearbyAreas(area);

const pageTitle = `${business.name} in ${area.name}`;
const metaDescription = `${business.name} provides B2B printing and branding services in ${area.name}, ${area.county}. ${area.responseTime} response time. Eco-solvent banners, stickers, corporate branding, and acrylic fabrication. Call ${business.phone}.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  description: `${business.name} provides B2B printing and branding services in ${area.name}, ${area.county}.`,
  telephone: business.phone,
  url: business.website,
  address: {
    '@type': 'PostalAddress',
    addressLocality: area.name,
    addressRegion: area.county,
    addressCountry: 'AE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: area.lat,
    longitude: area.lng,
  },
  areaServed: [
    { '@type': 'City', name: area.name },
    { '@type': 'AdministrativeArea', name: area.county },
  ],
  openingHoursSpecification: business.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.hours === 'Closed' ? undefined : '09:00',
    closes: h.hours === 'Closed' ? undefined : '19:00',
  })),
  priceRange: '$$',
};
---

<BaseLayout title={pageTitle} description={metaDescription} schema={schema}>
  <Breadcrumbs
    crumbs={[
      { label: 'Service Areas', href: '/areas/' },
      { label: area.name },
    ]}
  />

  <!-- Hero section -->
  <section class="on-dark relative overflow-hidden bg-gradient-to-br from-brand-900 to-brand-800">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(100,194,182,0.15),_transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-site gap-10 px-5 py-14 sm:px-6 md:grid-cols-12 md:px-8 md:py-20"
    >
      <div class="md:col-span-7 lg:col-span-8">
        <Reveal variant="fade">
          <Pill label={area.county} icon="lucide:map-pin" tone="onDark" />
        </Reveal>
        <Reveal variant="clip" delay={80}>
          <h1
            class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            {pageTitle}
          </h1>
        </Reveal>
        <Reveal variant="up" delay={200}>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-brand-200 sm:text-lg md:text-xl">
            {area.description}
          </p>
        </Reveal>
        <Reveal variant="up" delay={280}>
          <p class="mt-4 max-w-2xl text-sm leading-relaxed text-brand-300 sm:text-base">
            {business.name} proudly serves businesses in {area.name} and {area.county}. Whether you
            need eco-solvent banners for a construction site, vinyl stickers for product branding, a
            complete corporate rebrand, or custom acrylic displays for your retail space, our team
            delivers reliable, professional work at competitive B2B rates. We know this community
            because we are part of it.
          </p>
        </Reveal>
      </div>

      <div class="md:col-span-5 lg:col-span-4">
        <Reveal variant="right" delay={160}>
          <div
            class="rounded-3xl bg-white/5 p-6 ring-1 ring-white/10 backdrop-blur-sm lg:sticky lg:top-28"
          >
            <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-brand-400">
              Quick Facts
            </h2>

            <dl class="mt-5 space-y-5">
              <div>
                <dt class="text-[11px] font-medium uppercase tracking-[0.18em] text-brand-400">
                  Region
                </dt>
                <dd class="mt-1 font-display text-xl text-white">{area.county}</dd>
              </div>

              <div>
                <dt class="text-[11px] font-medium uppercase tracking-[0.18em] text-brand-400">
                  Population
                </dt>
                <dd class="mt-1">
                  <span
                    data-countup={area.population}
                    data-countup-format="comma"
                    class="font-display text-3xl tabular-nums tracking-tight text-white"
                  >
                    {area.population.toLocaleString()}
                  </span>
                </dd>
              </div>

              <div>
                <dt class="text-[11px] font-medium uppercase tracking-[0.18em] text-brand-400">
                  Response Time
                </dt>
                <dd class="mt-1 flex items-center gap-2 font-display text-xl text-white">
                  <Icon name="lucide:clock" class="size-5 text-accent-400" />
                  {area.responseTime}
                </dd>
              </div>
            </dl>

            <div class="mt-7 space-y-2 border-t border-white/10 pt-6">
              <a
                href={business.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex w-full items-center justify-center gap-2 rounded-full bg-accent-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors duration-300 hover:bg-accent-600"
              >
                <Icon name="lucide:message-circle" class="size-4" />
                WhatsApp
              </a>
              <a
                href={business.phoneHref}
                class="flex w-full items-center justify-center gap-2 rounded-full bg-white/10 px-4 py-2.5 text-sm font-semibold text-white ring-1 ring-white/15 transition-colors duration-300 hover:bg-white/20"
              >
                <Icon name="lucide:phone" class="size-4" />
                {business.phone}
              </a>
            </div>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Services available in this area -->
  <Section tone="plain" size="lg">
    <SectionHeading
      eyebrow="What we offer here"
      title={`Services Available in ${area.name}`}
      subcopy={`Our team handles everything from single banners to complete branding programs. Select a service below for details and pricing specific to ${area.name}.`}
      align="left"
      max="max-w-2xl"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        serviceTypes.map((service, i) => (
          <ServiceCard
            service={service}
            href={comboUrl(area.slug, service.slug)}
            variant="compact"
            headingLevel="h3"
            price="minmax"
            delay={Math.min(i, 5) * 70}
          />
        ))
      }
    </div>
  </Section>

  <!-- Nearby areas -->
  {
    nearbyAreas.length > 0 && (
      <Section tone="shade" size="lg">
        <SectionHeading
          eyebrow="Close by"
          title="Nearby Areas We Serve"
          subcopy={`In addition to ${area.name}, our service area covers these nearby business communities.`}
          align="left"
          max="max-w-2xl"
        />
        <div class="mt-10 grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {nearbyAreas.map((nearby, i) => (
            <AreaCard
              area={nearby}
              href={areaUrl(nearby.slug)}
              variant="compact"
              headingLevel="h3"
              showPopulation
              populationLabel
              showResponseTime={false}
              delay={Math.min(i, 5) * 70}
            />
          ))}
        </div>
      </Section>
    )
  }

  <!-- FAQ section -->
  <div class="border-t border-stone-200/60 bg-white">
    <SeoFaq area={area} />
  </div>

  <!-- Testimonials section -->
  <div class="mx-auto max-w-site px-5 sm:px-6 md:px-8">
    <SeoTestimonials area={area} />
  </div>

  <!-- CTA section -->
  <Section tone="deep" size="md" class="mt-16">
    <CtaBanner
      title={`Need Printing & Branding in ${area.name}?`}
      body={`${business.name} is locally based in Mussafah and serves businesses throughout ${area.county}. Contact us today for professional printing and branding services.`}
      primary={{
        label: 'WhatsApp Us',
        href: business.whatsappHref,
        icon: 'lucide:message-circle',
        external: true,
      }}
      secondary={{ label: 'Request a Quote', href: contactUrl(), icon: 'lucide:mail' }}
    />
  </Section>
</BaseLayout>
