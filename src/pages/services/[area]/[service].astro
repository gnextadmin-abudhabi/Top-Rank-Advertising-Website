---
import { business } from '../../../data/business';
import { serviceTypes } from '../../../data/serviceTypes';
import { serviceAreas, getNearbyAreas } from '../../../data/serviceAreas';
import type { ServiceType } from '../../../data/serviceTypes';
import type { ServiceArea } from '../../../data/serviceAreas';
import { serviceUrl, areaUrl, comboUrl, contactUrl } from '../../../lib/urls';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../components/SeoFaq.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import SeoServiceAreas from '../../../components/SeoServiceAreas.astro';
import SeoTestimonials from '../../../components/SeoTestimonials.astro';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  const paths = [];
  for (const area of serviceAreas) {
    for (const service of serviceTypes) {
      paths.push({
        params: { area: area.slug, service: service.slug },
        props: { area, service },
      });
    }
  }
  return paths;
}

interface Props {
  area: ServiceArea;
  service: ServiceType;
}

const { area, service } = Astro.props;
const nearbyAreas = getNearbyAreas(area);
const nearbyNames = nearbyAreas.map((a) => a.name).join(', ');

const pageTitle = `${service.name} in ${area.name} | ${business.name}`;
const pageDescription = `Need ${service.name.toLowerCase()} in ${area.name}? ${business.name} offers professional ${service.name.toLowerCase()} for B2B clients with ${area.responseTime} response times. Call ${business.phone} or WhatsApp.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}${comboUrl(area.slug, service.slug)}#service`,
      name: `${service.name} in ${area.name}`,
      description: `${service.description} Serving businesses in ${area.name}, ${area.county} and surrounding communities.`,
      provider: {
        '@type': 'LocalBusiness',
        '@id': `${business.website}/#business`,
        name: business.name,
        telephone: business.phone,
        url: business.website,
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address.street,
          addressLocality: business.address.city,
          addressRegion: business.address.state,
          addressCountry: 'AE',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: business.coordinates.lat,
          longitude: business.coordinates.lng,
        },
      },
      areaServed: [
        {
          '@type': 'City',
          name: area.name,
          containedInPlace: {
            '@type': 'AdministrativeArea',
            name: area.county,
          },
        },
      ],
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: service.priceRange.min,
        highPrice: service.priceRange.max,
        priceCurrency: 'AED',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}/services/` },
        { '@type': 'ListItem', position: 3, name: area.name, item: `${business.website}${areaUrl(area.slug)}` },
        { '@type': 'ListItem', position: 4, name: service.name },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${business.website}${comboUrl(area.slug, service.slug)}`}
  schema={schema}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: area.name, href: areaUrl(area.slug) },
      { label: service.name },
    ]}
  />

  <article class="mx-auto max-w-7xl px-5 lg:px-8">
    <!-- ============ HERO / H1 ============ -->
    <header class="pb-10 pt-6 lg:pt-10">
      <div class="lg:flex lg:items-start lg:gap-10">
        <div class="lg:flex-1">
          <div class="flex items-center gap-3 text-brand-600">
            <Icon name={service.icon} class="size-8" />
            <span class="text-sm font-semibold uppercase tracking-wide">
              Professional {service.name}
            </span>
          </div>
          <h1 class="mt-3 font-display text-3xl text-brand-900 sm:text-4xl lg:text-5xl">
            {service.name} in {area.name}
          </h1>
          <p class="mt-4 max-w-3xl text-lg leading-relaxed text-stone-600">
            {pageDescription}
          </p>
        </div>
        <div class="mt-6 lg:mt-0 lg:w-80 lg:shrink-0">
          <img
            src={service.image}
            alt={`${service.name} in ${area.name}`}
            class="rounded-xl shadow-lg"
            width="1024"
            height="1024"
            loading="eager"
          />
        </div>
      </div>
    </header>

    <!-- ============ SERVICE IMAGE ============ -->
    <div class="mb-10 overflow-hidden rounded-xl">
      <img
        src={service.image}
        alt={`${service.name} service in ${area.name}`}
        class="h-64 w-full object-cover sm:h-80 lg:h-96"
        width="1408"
        height="768"
        loading="eager"
      />
    </div>

    <!-- ============ DESCRIPTION SECTION ============ -->
    <section class="prose-editorial max-w-3xl pb-12">
      <h2>Expert {service.name} Serving {area.name} and {area.county}</h2>
      <p>
        {service.description}
      </p>
      <p>
        At {business.name}, we have been supporting businesses in {area.name} and the greater {area.county} area with professional printing and branding solutions. As a locally based B2B provider, we understand the unique needs of corporate, retail, construction, and event clients in this region. {area.description}
      </p>
      {nearbyAreas.length > 0 && (
        <p>
          In addition to {area.name}, our {service.name.toLowerCase()} service covers nearby
          business communities including {nearbyNames}. No matter where your project is located, you
          can count on fast response times and professional workmanship from our team.
        </p>
      )}
    </section>

    <!-- ============ PRICE SECTION ============ -->
    <section class="pb-12">
      <div class="rounded-xl border border-stone-200 bg-white p-8 lg:p-10">
        <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">
          What Does {service.name} Cost in {area.name}?
        </h2>
        <div class="mt-6 flex items-baseline gap-2">
          <span class="font-display text-4xl text-brand-700">
            AED {service.priceRange.min.toLocaleString()}
          </span>
          <span class="text-2xl text-stone-400">–</span>
          <span class="font-display text-4xl text-brand-700">
            AED {service.priceRange.max.toLocaleString()}
          </span>
        </div>
        <p class="mt-3 text-sm text-stone-500">
          Typical project range for {service.name.toLowerCase()} in {area.name}. Final cost depends on quantities,
          materials, finishing, and complexity. B2B volume pricing available.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <div class="flex items-center gap-2 text-sm text-stone-600">
            <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
            <span>Free project consultation</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-stone-600">
            <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
            <span>No hidden fees</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-stone-600">
            <Icon name="lucide:check-circle" class="size-5 text-brand-600" />
            <span>Project-based quotation</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ PROCESS STEPS ============ -->
    <section class="pb-16">
      <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">
        Our {service.name} Process
      </h2>
      <p class="mt-3 max-w-2xl text-stone-600">
        Every project follows a clear, proven process so you always know what to expect.
      </p>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {service.processSteps.map((step, index) => (
          <div class="relative rounded-xl border border-stone-200 bg-white p-6">
            <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-brand-50 font-display text-lg text-brand-700">
              {index + 1}
            </div>
            <h3 class="font-display text-lg text-brand-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ WHY CHOOSE US ============ -->
    <section class="pb-16">
      <h2 class="font-display text-2xl text-brand-900 sm:text-3xl">
        Why Choose {business.name} in {area.name}?
      </h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-xl border border-stone-200 bg-white p-6 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50">
            <Icon name="lucide:check-circle" class="size-6 text-brand-700" />
          </div>
          <h3 class="mt-4 font-semibold text-brand-900">End-to-End Service</h3>
          <p class="mt-2 text-sm text-stone-600">
            From design to delivery and installation, we handle every step.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-6 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50">
            <Icon name="lucide:map-pin" class="size-6 text-brand-700" />
          </div>
          <h3 class="mt-4 font-semibold text-brand-900">Locally Based</h3>
          <p class="mt-2 text-sm text-stone-600">
            Workshop in Mussafah with fast delivery across {area.county}.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-6 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50">
            <Icon name="lucide:clock" class="size-6 text-brand-700" />
          </div>
          <h3 class="mt-4 font-semibold text-brand-900">Fast Response</h3>
          <p class="mt-2 text-sm text-stone-600">
            {area.responseTime} response time to {area.name}. We meet deadlines.
          </p>
        </div>

        <div class="rounded-xl border border-stone-200 bg-white p-6 text-center">
          <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-brand-50">
            <Icon name="lucide:badge-check" class="size-6 text-brand-700" />
          </div>
          <h3 class="mt-4 font-semibold text-brand-900">Quality Guaranteed</h3>
          <p class="mt-2 text-sm text-stone-600">
            We stand behind every product with quality checks at every stage.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ CTA SECTION ============ -->
    <section class="pb-16">
      <div class="rounded-2xl bg-gradient-to-br from-brand-900 to-brand-800 p-8 text-center lg:p-12">
        <h2 class="font-display text-2xl text-white sm:text-3xl">
          Ready to Schedule {service.name} in {area.name}?
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-brand-200">
          Whether you need a single item or a large volume order, our team is here to help. Contact us today for a project-based quotation.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600 hover:shadow-xl"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp {business.phone}
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition-all hover:bg-white/20"
          >
            <Icon name="lucide:mail" class="size-5" />
            Request a Quotation
          </a>
        </div>
      </div>
    </section>

    <!-- ============ SEO COMPONENTS ============ -->
    <section class="pb-8">
      <SeoRelatedLinks area={area} service={service} />
    </section>

    <section class="pb-8">
      <SeoServiceAreas currentArea={area} service={service} />
    </section>

    <SeoTestimonials area={area} service={service} />
  </article>

  <SeoFaq area={area} service={service} />
</BaseLayout>
