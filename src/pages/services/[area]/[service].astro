---
import MediaFrame from '../../../components/ui/MediaFrame.astro';
import { business } from '../../../data/business';
import { serviceTypes } from '../../../data/serviceTypes';
import { serviceAreas, getNearbyAreas } from '../../../data/serviceAreas';
import type { ServiceType } from '../../../data/serviceTypes';
import type { ServiceArea } from '../../../data/serviceAreas';
import { serviceUrl, areaUrl, comboUrl, contactUrl } from '../../../lib/urls';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SeoFaq from '../../../components/SeoFaq.astro';

import Reveal from '../../../components/ui/Reveal.astro';
import Pill from '../../../components/ui/Pill.astro';
import ProcessSteps from '../../../components/ui/ProcessSteps.astro';
import FeatureCard from '../../../components/ui/FeatureCard.astro';
import CtaBanner from '../../../components/ui/CtaBanner.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import SeoServiceAreas from '../../../components/SeoServiceAreas.astro';
import SeoTestimonials from '../../../components/SeoTestimonials.astro';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  const paths = [];
  for (const area of serviceAreas) {
    for (const service of serviceTypes) {
      paths.push({
        params: { area: area.slug, service: service.slug },
        props: { area, service },
      });
    }
  }
  return paths;
}

interface Props {
  area: ServiceArea;
  service: ServiceType;
}

const { area, service } = Astro.props;
const nearbyAreas = getNearbyAreas(area);
const nearbyNames = nearbyAreas.map((a) => a.name).join(', ');

const pageTitle = `${service.name} in ${area.name} | ${business.name}`;
const pageDescription = `Need ${service.name.toLowerCase()} in ${area.name}? ${business.name} offers professional ${service.name.toLowerCase()} for B2B clients with ${area.responseTime} response times. Call ${business.phone} or WhatsApp.`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${business.website}${comboUrl(area.slug, service.slug)}#service`,
      name: `${service.name} in ${area.name}`,
      description: `${service.description} Serving businesses in ${area.name}, ${area.county} and surrounding communities.`,
      provider: {
        '@type': 'LocalBusiness',
        '@id': `${business.website}/#business`,
        name: business.name,
        telephone: business.phone,
        url: business.website,
        address: {
          '@type': 'PostalAddress',
          streetAddress: business.address.street,
          addressLocality: business.address.city,
          addressRegion: business.address.state,
          addressCountry: 'AE',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: business.coordinates.lat,
          longitude: business.coordinates.lng,
        },
      },
      areaServed: [
        {
          '@type': 'City',
          name: area.name,
          containedInPlace: {
            '@type': 'AdministrativeArea',
            name: area.county,
          },
        },
      ],
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: service.priceRange.min,
        highPrice: service.priceRange.max,
        priceCurrency: 'AED',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: business.website },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${business.website}/services/` },
        { '@type': 'ListItem', position: 3, name: area.name, item: `${business.website}${areaUrl(area.slug)}` },
        { '@type': 'ListItem', position: 4, name: service.name },
      ],
    },
  ],
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={`${business.website}${comboUrl(area.slug, service.slug)}`}
  schema={schema}
  preloadImage={service.image.src}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: area.name, href: areaUrl(area.slug) },
      { label: service.name },
    ]}
  />

  <!-- ============ HERO ============ -->
  <!-- Two columns instead of a text block above a full-bleed band: the image
       is sized to the copy beside it rather than dominating the page. -->
  <section class="on-dark relative overflow-hidden bg-gradient-to-br from-brand-900 to-brand-800">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(100,194,182,0.15),_transparent_70%)]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid max-w-site items-center gap-10 px-5 py-14 sm:px-6 md:px-8 md:py-20 lg:grid-cols-12 lg:gap-14"
    >
      <div class="lg:col-span-7">
        <Reveal variant="fade">
          <Pill label={`Professional ${service.name}`} icon={service.icon} tone="onDark" />
        </Reveal>
        <Reveal variant="clip" delay={80}>
          <h1
            class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            {service.name} in {area.name}
          </h1>
        </Reveal>
        <Reveal variant="up" delay={200}>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-brand-200 sm:text-lg">
            {pageDescription}
          </p>
        </Reveal>
      </div>

      <div class="lg:col-span-5">
        <Reveal variant="scale" delay={160}>
          <MediaFrame
            src={service.image}
            alt={`${service.name} service in ${area.name}`}
            ratio="4/3"
            rounded="2xl"
            priority
            sizes="(min-width: 1024px) 40vw, 100vw"
            class="shadow-brand-lg ring-1 ring-white/10"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-site px-5 pt-14 sm:px-6 md:px-8 md:pt-20">
    <!-- ============ DESCRIPTION + PRICE ============ -->
    <!-- Prose and price sit side by side, so the copy column no longer leaves
         half the page empty and the price panel is no longer oversized. -->
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <Reveal variant="up" as="div" class="prose-editorial lg:col-span-7">
        <h2>Expert {service.name} Serving {area.name} and {area.county}</h2>
        <p>
          {service.description}
        </p>
        <p>
          At {business.name}, we have been supporting businesses in {area.name} and the greater {area.county} area with professional printing and branding solutions. As a locally based B2B provider, we understand the unique needs of corporate, retail, construction, and event clients in this region. {area.description}
        </p>
        {nearbyAreas.length > 0 && (
          <p>
            In addition to {area.name}, our {service.name.toLowerCase()} service covers nearby
            business communities including {nearbyNames}. No matter where your project is located, you
            can count on fast response times and professional workmanship from our team.
          </p>
        )}
      </Reveal>

      <Reveal variant="right" delay={120} as="aside" class="lg:col-span-5">
        <div class="rounded-3xl bg-brand-50 p-7 ring-1 ring-brand-500/15 sm:p-8 lg:sticky lg:top-28">
          <h2 class="font-display text-xl tracking-tight text-brand-900 sm:text-2xl">
            What Does {service.name} Cost in {area.name}?
          </h2>

          <div class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1">
            <span class="font-display text-3xl tracking-tight text-brand-700 sm:text-4xl">
              AED {service.priceRange.min.toLocaleString()}
            </span>
            <span class="text-xl text-brand-400">&ndash;</span>
            <span class="font-display text-3xl tracking-tight text-brand-700 sm:text-4xl">
              AED {service.priceRange.max.toLocaleString()}
            </span>
          </div>

          <p class="mt-4 text-sm leading-relaxed text-stone-600">
            Typical project range for {service.name.toLowerCase()} in {area.name}. Final cost
            depends on quantities, materials, finishing, and complexity. B2B volume pricing
            available.
          </p>

          <ul class="mt-6 space-y-3 border-t border-brand-500/15 pt-5">
            {
              ['Free project consultation', 'No hidden fees', 'Project-based quotation'].map(
                (item) => (
                  <li class="flex items-center gap-2.5 text-sm font-medium text-brand-800">
                    <Icon name="lucide:check-circle" class="size-4 shrink-0 text-accent-500" />
                    <span>{item}</span>
                  </li>
                ),
              )
            }
          </ul>
        </div>
      </Reveal>
    </div>

    <!-- ============ PROCESS STEPS ============ -->
    <section class="pb-16 pt-16 md:pt-20">
      <Reveal variant="up">
        <h2 class="font-display text-2xl tracking-tight text-brand-900 sm:text-3xl md:text-4xl">
          Our {service.name} Process
        </h2>
      </Reveal>
      <Reveal variant="up" delay={90}>
        <p class="mt-3 max-w-2xl text-stone-600">
          Every project follows a clear, proven process so you always know what to expect.
        </p>
      </Reveal>
      <div class="mt-10">
        <ProcessSteps steps={service.processSteps} layout="grid" />
      </div>
    </section>

    <!-- ============ WHY CHOOSE US ============ -->
    <section class="pb-16">
      <Reveal variant="up">
        <h2 class="font-display text-2xl tracking-tight text-brand-900 sm:text-3xl md:text-4xl">
          Why Choose {business.name} in {area.name}?
        </h2>
      </Reveal>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <FeatureCard
          icon="lucide:check-circle"
          title="End-to-End Service"
          detail="From design to delivery and installation, we handle every step."
          delay={0}
        />
        <FeatureCard
          icon="lucide:map-pin"
          title="Locally Based"
          detail={`Workshop in Mussafah with fast delivery across ${area.county}.`}
          delay={80}
          class="lg:translate-y-6"
        />
        <FeatureCard
          icon="lucide:clock"
          title="Fast Response"
          detail={`${area.responseTime} response time to ${area.name}. We meet deadlines.`}
          delay={160}
          class="lg:translate-y-6"
        />
        <FeatureCard
          icon="lucide:badge-check"
          title="Quality Guaranteed"
          detail="We stand behind every product with quality checks at every stage."
          delay={240}
        />
      </div>
    </section>

    <!-- ============ CTA SECTION ============ -->
    <section class="pb-16">
      <CtaBanner
        tone="panel"
        title={`Ready to Schedule ${service.name} in ${area.name}?`}
        body="Whether you need a single item or a large volume order, our team is here to help. Contact us today for a project-based quotation."
        primary={{
          label: `WhatsApp ${business.phone}`,
          href: business.whatsappHref,
          icon: 'lucide:message-circle',
          external: true,
        }}
        secondary={{
          label: 'Request a Quotation',
          href: contactUrl(),
          icon: 'lucide:mail',
        }}
      />
    </section>

    <!-- ============ SEO COMPONENTS ============ -->
    <section class="pb-8">
      <SeoRelatedLinks area={area} service={service} />
    </section>

    <section class="pb-8">
      <SeoServiceAreas currentArea={area} service={service} />
    </section>

    <SeoTestimonials area={area} service={service} />
  </article>

  <SeoFaq area={area} service={service} />
</BaseLayout>
