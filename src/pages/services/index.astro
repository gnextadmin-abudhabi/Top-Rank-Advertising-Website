---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { business } from '../../data/business';
import { serviceTypes } from '../../data/serviceTypes';
import { serviceUrl, contactUrl } from '../../lib/urls';

import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'B2B Printing & Branding Services',
  description: `${business.name} offers professional printing and branding services for businesses across Abu Dhabi and Al Ain.`,
  itemListElement: serviceTypes.map((service, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: service.name,
    description: service.shortDescription,
    url: `${business.website}${serviceUrl(service.slug)}`,
  })),
};
---

<BaseLayout
  title={`B2B Printing & Branding Services | ${business.name}`}
  description={`${business.name} offers a full range of B2B printing and branding services across Abu Dhabi and Al Ain. From banners and stickers to corporate branding and acrylic fabrication.`}
  schema={servicesSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Services' }]} />

  <!-- ============ HEADER ============ -->
  <Section tone="paper" size="sm">
    <SectionHeading
      eyebrow="Our capabilities"
      title="Our B2B Printing & Branding Services"
      as="h1"
      size="page"
      align="left"
      max="max-w-3xl"
      subcopy={`Whether you need a single banner for an event or a complete corporate rebrand with fleet graphics and acrylic signage, ${business.name} provides end-to-end printing and branding solutions for businesses throughout Abu Dhabi and Al Ain.`}
    />
  </Section>

  <!-- ============ SERVICES GRID ============ -->
  <Section tone="plain" size="lg">
    <!-- headingLevel stays h2 here: this page's card titles are its outline. -->
    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        serviceTypes.map((service, i) => (
          <ServiceCard
            service={service}
            href={serviceUrl(service.slug)}
            variant={i >= serviceTypes.length - 2 ? 'wide' : 'photo'}
            headingLevel="h2"
            price="range"
            delay={Math.min(i, 5) * 70}
          />
        ))
      }
    </div>
  </Section>

  <!-- ============ CTA ============ -->
  <Section tone="deep" size="md">
    <CtaBanner
      title="Not Sure What You Need?"
      body="Contact us and describe your project. We will recommend the right services and provide a tailored quotation."
      primary={{
        label: 'WhatsApp',
        href: business.whatsappHref,
        icon: 'lucide:message-circle',
        external: true,
      }}
      secondary={{ label: 'Request a Quote', href: contactUrl() }}
    />
  </Section>
</BaseLayout>
