---
import { Icon } from 'astro-icon/components';
import { business } from '../../data/business';
import { serviceTypes, getServiceBySlug } from '../../data/serviceTypes';
import { serviceAreas } from '../../data/serviceAreas';
import { comboUrl, contactUrl } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SeoFaq from '../../components/SeoFaq.astro';

import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Pill from '../../components/ui/Pill.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';
import ProcessSteps from '../../components/ui/ProcessSteps.astro';
import AreaCard from '../../components/ui/AreaCard.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

import type { ServiceType } from '../../data/serviceTypes';

export function getStaticPaths() {
  return serviceTypes.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServiceType;
}

const { service } = Astro.props;

const mussafah = serviceAreas.find((a) => a.slug === 'mussafah')!;

const pageTitle = `${service.name} in Abu Dhabi & Al Ain`;
const metaDescription = service.description.length > 155
  ? service.description.slice(0, 152) + '...'
  : service.description;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.description,
  provider: {
    '@type': 'LocalBusiness',
    name: business.name,
    telephone: business.phone,
    url: business.website,
    address: {
      '@type': 'PostalAddress',
      streetAddress: business.address.street,
      addressLocality: business.address.city,
      addressRegion: business.address.state,
      addressCountry: 'AE',
    },
  },
  areaServed: serviceAreas.map((area) => ({
    '@type': 'City',
    name: area.name,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: area.county,
    },
  })),
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'AED',
      minPrice: service.priceRange.min,
      maxPrice: service.priceRange.max,
    },
  },
};
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  schema={schema}
  preloadImage={service.image.src}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Services', href: '/services/' },
      { label: service.name },
    ]}
  />

  <!-- Hero section -->
  <section class="on-dark relative overflow-hidden bg-gradient-to-br from-brand-900 to-brand-800">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_rgba(100,194,182,0.15),_transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="relative mx-auto grid max-w-site items-center gap-10 px-5 py-14 sm:px-6 md:grid-cols-12 md:px-8 md:py-20"
    >
      <div class="md:col-span-7">
        <Reveal variant="fade">
          <Pill label={`Professional ${service.name}`} icon={service.icon} tone="onDark" />
        </Reveal>
        <Reveal variant="clip" delay={80}>
          <h1
            class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-white sm:text-5xl md:text-6xl"
          >
            {pageTitle}
          </h1>
        </Reveal>
        <Reveal variant="up" delay={200}>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-brand-200 sm:text-lg">
            {service.description}
          </p>
        </Reveal>
        <Reveal variant="up" delay={300}>
          <div
            class="mt-7 inline-flex items-center gap-2 rounded-full bg-white/10 px-5 py-3 text-sm font-medium text-white ring-1 ring-white/20"
          >
            <Icon name="lucide:banknote" class="size-4 text-accent-400" />
            Typical project range: AED {service.priceRange.min.toLocaleString()} - AED {
              service.priceRange.max.toLocaleString()
            }
          </div>
        </Reveal>
      </div>

      <div class="md:col-span-5">
        <Reveal variant="scale" delay={160}>
          <MediaFrame
            src={service.image}
            alt={`${service.name} service by ${business.name}`}
            ratio="4/3"
            priority
            sizes="(min-width: 768px) 40vw, 100vw"
            class="shadow-brand-lg ring-1 ring-white/10"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Process steps section -->
  <Section tone="plain" size="lg">
    <SectionHeading
      eyebrow="How it works"
      title={`Our ${service.name} Process`}
      subcopy="Every project follows a clear, proven process so you know exactly what to expect from start to finish."
      align="left"
      max="max-w-2xl"
    />
    <div class="mt-12">
      <ProcessSteps steps={service.processSteps} layout="grid" />
    </div>
  </Section>

  <!-- Areas we serve for this service -->
  <Section tone="shade" size="lg">
    <SectionHeading
      eyebrow="Coverage"
      title={`Areas We Serve for ${service.name}`}
      subcopy={`We provide ${service.name.toLowerCase()} across Abu Dhabi and Al Ain. Select your area for local pricing and availability.`}
      align="left"
      max="max-w-2xl"
    />
    <div class="mt-10 grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      {
        serviceAreas.map((area, i) => (
          <AreaCard
            area={area}
            href={comboUrl(area.slug, service.slug)}
            variant="compact"
            headingLevel="h3"
            responseLabel={`Response time: ${area.responseTime}`}
            delay={Math.min(i, 5) * 70}
          />
        ))
      }
    </div>
  </Section>

  <!-- FAQ section. `mussafah` is deliberately hardcoded here. -->
  <div class="border-t border-stone-200/60 bg-white">
    <SeoFaq area={mussafah} service={service} />
  </div>

  <!-- CTA section -->
  <Section tone="deep" size="md">
    <CtaBanner
      title={`Need ${service.name}?`}
      body={`${business.name} serves businesses across Abu Dhabi and Al Ain. Contact us today for a project-based quotation or to schedule a consultation.`}
      primary={{
        label: 'WhatsApp Us',
        href: business.whatsappHref,
        icon: 'lucide:message-circle',
        external: true,
      }}
      secondary={{ label: 'Request a Quote', href: contactUrl(), icon: 'lucide:mail' }}
    />
  </Section>
</BaseLayout>
