---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceTypes } from '../data/serviceTypes';
import { serviceAreas } from '../data/serviceAreas';

// Web3Forms access key. Paste yours into .env as PUBLIC_WEB3FORMS_ACCESS_KEY
// (see .env.example). Until it is set the form still renders and validates,
// but submissions will be rejected by the provider.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';

const contactSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': `${business.website}/contact/#webpage`,
      url: `${business.website}/contact/`,
      name: `Contact ${business.name}`,
      description: `Get in touch with ${business.name} for B2B printing and branding services in Abu Dhabi and Al Ain.`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '09:00',
          closes: '19:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Friday',
          opens: '14:30',
          closes: '19:00',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`Contact Us | ${business.name}`}
  description={`Get in touch with ${business.name} for a B2B printing and branding quotation. Call ${business.phone}, WhatsApp, or fill out our contact form. Serving businesses across Abu Dhabi and Al Ain.`}
  schema={contactSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Contact' }]} />

  <!-- ============ HEADER ============ -->
  <Section tone="paper" size="sm">
    <SectionHeading
      eyebrow="Get in touch"
      title={`Contact ${business.name}`}
      as="h1"
      size="page"
      align="left"
      max="max-w-3xl"
      subcopy="Have a project in mind or need a quotation? Reach out by phone, WhatsApp, email, or use the form below. We typically respond within one business day."
    />
  </Section>

  <!-- ============ FORM + CONTACT INFO ============ -->
  <Section tone="plain" size="lg">
      <div class="grid gap-10 md:grid-cols-12 lg:gap-14">
        <!-- Left: Contact Form -->
        <div class="md:col-span-7">
          <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-brand-sm sm:p-8 md:p-10">
            <h2 class="font-display text-2xl tracking-tight text-brand-900 sm:text-3xl">Send Us a Message</h2>
            <p class="mt-2 text-sm text-stone-500">
              Fill out the form and we will get back to you as soon as possible.
            </p>

            <form
              action="https://api.web3forms.com/submit"
              method="POST"
              class="mt-8 space-y-6"
              id="contact-form"
            >
              <input type="hidden" name="access_key" value={web3formsKey} />
              <input
                type="hidden"
                name="subject"
                value="New project enquiry from toprankadvertising.com"
              />
              <input type="hidden" name="from_name" value={business.name} />
              {/* Honeypot: bots fill this, humans never see it. */}
              <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display:none"
                tabindex="-1"
                autocomplete="off"
              />
              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-stone-700">
                    Full Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Your name"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="company" class="block text-sm font-medium text-stone-700">
                    Company Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    required
                    placeholder="Your company"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="email" class="block text-sm font-medium text-stone-700">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="you@company.com"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
                <div>
                  <label for="phone" class="block text-sm font-medium text-stone-700">
                    Phone Number
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    placeholder="+971 50 000 0000"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  />
                </div>
              </div>

              <div class="grid gap-6 sm:grid-cols-2">
                <div>
                  <label for="service" class="block text-sm font-medium text-stone-700">
                    Service Needed
                  </label>
                  <select
                    id="service"
                    name="service"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  >
                    <option value="">Select a service</option>
                    {serviceTypes.map((service) => (
                      <option value={service.slug}>{service.name}</option>
                    ))}
                    <option value="other">Other / Not Sure</option>
                  </select>
                </div>
                <div>
                  <label for="area" class="block text-sm font-medium text-stone-700">
                    Your Area
                  </label>
                  <select
                    id="area"
                    name="area"
                    class="mt-1.5 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                  >
                    <option value="">Select your area</option>
                    {serviceAreas.map((area) => (
                      <option value={area.slug}>{area.name}</option>
                    ))}
                    <option value="other">Other Location</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-stone-700">
                  Project Details <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Describe your project, quantities, timeline, and any specific requirements..."
                  class="mt-1.5 w-full rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 transition-colors focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none"
                ></textarea>
              </div>

              <button
                type="submit"
                id="contact-submit"
                class="group inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-brand-800 px-6 py-3 text-sm font-semibold text-white shadow-brand-sm transition-colors duration-300 hover:bg-brand-900 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
              >
                <Icon name="lucide:send" class="size-4" />
                <span id="contact-submit-label">Send Message</span>
                <span
                  class="btn-arrow__circle flex size-6 items-center justify-center rounded-full bg-white/20"
                  aria-hidden="true"
                >
                  <Icon name="lucide:arrow-right" class="size-3.5" />
                </span>
              </button>

              <p
                id="contact-success"
                class="hidden items-start gap-2 rounded-xl bg-brand-50 p-4 text-sm text-brand-800 ring-1 ring-brand-500/20"
                role="status"
              >
                <Icon name="lucide:check-circle" class="mt-0.5 size-4 shrink-0 text-accent-500" />
                <span>Thank you. Your message has been sent. We typically respond within one business day.</span>
              </p>

              <p
                id="contact-error"
                class="hidden items-start gap-2 rounded-xl bg-red-50 p-4 text-sm text-red-700 ring-1 ring-red-200"
                role="alert"
              >
                <Icon name="lucide:info" class="mt-0.5 size-4 shrink-0" />
                <span>
                  Sorry, something went wrong sending your message. Please WhatsApp or call us on
                  {business.phone} instead.
                </span>
              </p>
            </form>
          </div>
        </div>

        <!-- Right: Contact Info Card -->
        <div class="md:col-span-5">
          <div class="rounded-3xl border border-stone-200 bg-white p-6 shadow-brand-sm sm:p-8 lg:sticky lg:top-28">
            <h2 class="font-display text-2xl tracking-tight text-brand-900 sm:text-3xl">Contact Information</h2>

            <ul class="mt-6 space-y-5">
              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50">
                  <Icon name="lucide:phone" class="size-5 text-brand-700" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">Mobile</p>
                  <a href={business.phoneHref} class="text-sm text-brand-700 transition-colors hover:text-brand-900">
                    {business.phone}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50">
                  <Icon name="lucide:phone" class="size-5 text-brand-700" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">Landline</p>
                  <a href={business.landlineHref} class="text-sm text-brand-700 transition-colors hover:text-brand-900">
                    {business.landline}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent-50">
                  <Icon name="lucide:message-circle" class="size-5 text-accent-600" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">WhatsApp</p>
                  <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="text-sm text-accent-600 transition-colors hover:text-accent-800">
                    {business.whatsapp}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50">
                  <Icon name="lucide:mail" class="size-5 text-brand-700" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">Email</p>
                  <a href={`mailto:${business.email}`} class="text-sm text-brand-700 transition-colors hover:text-brand-900">
                    {business.email}
                  </a>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50">
                  <Icon name="lucide:map-pin" class="size-5 text-brand-700" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">Workshop</p>
                  <p class="text-sm text-stone-600">
                    {business.address.street}, {business.address.city}, {business.address.state}
                  </p>
                </div>
              </li>

              <li class="flex items-start gap-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50">
                  <Icon name="lucide:clock" class="size-5 text-brand-700" />
                </div>
                <div>
                  <p class="text-sm font-medium text-stone-700">Business Hours</p>
                  <div class="mt-1 space-y-0.5 text-sm text-stone-600">
                    {business.hours.map((schedule) => (
                      <p>
                        <span class="font-medium">{schedule.days}:</span> {schedule.hours}
                      </p>
                    ))}
                  </div>
                </div>
              </li>
            </ul>

            <div class="mt-8 rounded-lg border border-brand-200 bg-brand-50 p-4">
              <div class="flex items-start gap-3">
                <Icon name="lucide:message-circle" class="mt-0.5 size-5 shrink-0 text-accent-600" />
                <div>
                  <p class="text-sm font-semibold text-brand-800">Prefer WhatsApp?</p>
                  <p class="mt-1 text-sm text-brand-700">
                    Click to chat with us on WhatsApp at
                    <a href={business.whatsappHref} target="_blank" rel="noopener noreferrer" class="font-semibold underline">
                      {business.whatsapp}
                    </a>.
                    We typically reply within minutes during business hours.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
  </Section>

  <script>
    // The form has a real `action`, so it still works without JS. This just
    // upgrades it to an inline submit with status messages.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const btn = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const label = document.getElementById('contact-submit-label');
    const okBox = document.getElementById('contact-success');
    const errBox = document.getElementById('contact-error');

    if (form && btn && label && okBox && errBox) {
      const show = (el: HTMLElement) => {
        el.classList.remove('hidden');
        el.classList.add('flex');
      };
      const hide = (el: HTMLElement) => {
        el.classList.add('hidden');
        el.classList.remove('flex');
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        hide(okBox);
        hide(errBox);
        btn.disabled = true;
        const original = label.textContent;
        label.textContent = 'Sending...';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) {
            form.reset();
            show(okBox);
          } else {
            show(errBox);
          }
        } catch {
          show(errBox);
        } finally {
          btn.disabled = false;
          label.textContent = original;
        }
      });
    }
  </script>
</BaseLayout>
