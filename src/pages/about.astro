---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceAreas } from '../data/serviceAreas';
import { areaUrl, contactUrl } from '../lib/urls';
---

<BaseLayout
  title={`About ${business.name} | B2B Printing & Branding Abu Dhabi`}
  description={`Learn about ${business.name}, a B2B printing and branding company based in Mussafah, Abu Dhabi. Serving corporate, retail, construction, and event clients across Abu Dhabi and Al Ain.`}
>
  <Breadcrumbs crumbs={[{ label: 'About' }]} />

  <!-- ============ HEADER ============ -->
  <section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl animate-fade-up">
        <h1 class="font-display text-4xl text-brand-900 sm:text-5xl">
          About {business.name}
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-stone-600">
          A dedicated B2B printing and branding partner for businesses across Abu Dhabi and Al Ain. From banners and stickers to complete corporate identity systems and custom acrylic fabrication.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ OUR STORY ============ -->
  <section class="pb-16 lg:pb-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="prose-editorial">
          <h2>Our Story</h2>
          <p>
            {business.name} was founded with a clear mission: to provide Abu Dhabi businesses with a reliable, end-to-end printing and branding partner that understands B2B needs. No retail queues, no one-size-fits-all templates, just professional service tailored to corporate, retail, construction, and event clients.
          </p>
          <p>
            Based in Mussafah Industrial Area, we operate from a fully equipped workshop with large-format eco-solvent printers, digital presses, CNC routers, laser cutters, and a skilled team of designers and fabricators. This means we control quality from design to delivery.
          </p>
          <p>
            Over the years, we have built lasting relationships with construction firms needing site hoardings, retail chains requiring consistent point-of-sale materials, event agencies launching product activations, and corporate offices updating their brand presence across multiple locations.
          </p>
          <p>
            Our approach is simple: understand your business, recommend the right materials and finishes, deliver on time, and stand behind every product we ship. That is why our clients come back project after project.
          </p>
        </div>

        <div>
          <div class="rounded-xl border border-stone-200 bg-white p-8">
            <div class="flex items-center gap-4">
              <div class="flex size-16 items-center justify-center rounded-full bg-brand-100">
                <Icon name="lucide:building-2" class="size-8 text-brand-700" />
              </div>
              <div>
                <h3 class="font-display text-xl text-brand-900">{business.legalName}</h3>
                <p class="text-sm text-stone-500">B2B Printing & Branding</p>
              </div>
            </div>
            <div class="mt-6 space-y-3 text-sm leading-relaxed text-stone-600">
              <p>
                We specialize in eco-solvent banner printing, vinyl sticker production, corporate branding packages, and customized acrylic fabrication. Every project starts with a consultation and ends with a quality-checked delivery.
              </p>
              <p>
                Our team combines design expertise with industrial production capability, allowing us to handle everything from a single roll-up banner to a full fleet branding program for dozens of vehicles.
              </p>
            </div>
            <div class="mt-6 border-t border-stone-100 pt-6">
              <p class="text-xs font-medium uppercase tracking-wider text-stone-400">Why B2B Clients Choose Us</p>
              <div class="mt-2 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  End-to-End Service
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  On-Time Delivery
                </span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">
                  <Icon name="lucide:check-circle" class="size-3.5" />
                  Volume Pricing
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST SIGNALS ============ -->
  <section class="bg-stone-100 py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="text-center font-display text-3xl text-brand-900">
        Why Businesses Trust Us
      </h2>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          {
            icon: 'lucide:check-circle',
            title: 'End-to-End Service',
            detail: 'From design and pre-press to printing, fabrication, and installation. One partner for your entire project.',
          },
          {
            icon: 'lucide:clock',
            title: 'On-Time Delivery',
            detail: 'We commit to realistic timelines and communicate proactively if anything changes. Your deadlines matter.',
          },
          {
            icon: 'lucide:tags',
            title: 'B2B Volume Pricing',
            detail: 'Larger orders and repeat clients benefit from tiered pricing. We help you maximize your marketing budget.',
          },
          {
            icon: 'lucide:shield-check',
            title: 'Quality Guaranteed',
            detail: 'Every product is checked for color accuracy, structural integrity, and finish before it leaves our workshop.',
          },
        ].map((item, i) => (
          <div class={`rounded-xl border border-stone-200 bg-white p-6 animate-fade-up stagger-${i + 1}`}>
            <div class="flex size-12 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
              <Icon name={item.icon} class="size-6" />
            </div>
            <h3 class="mt-4 font-display text-lg text-brand-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ AREAS WE COVER ============ -->
  <section class="py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 class="text-center font-display text-3xl text-brand-900">
        Areas We Serve
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-stone-600">
        We provide printing and branding services to businesses throughout Abu Dhabi and Al Ain.
      </p>

      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {serviceAreas.map((area) => (
          <a
            href={areaUrl(area.slug)}
            class="card-hover flex items-center gap-3 rounded-xl border border-stone-200 bg-white px-5 py-4 transition-colors"
          >
            <Icon name="lucide:map-pin" class="size-5 shrink-0 text-brand-600" />
            <div>
              <span class="font-medium text-brand-900">{area.name}</span>
              <span class="block text-xs text-stone-500">{area.county}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="bg-brand-900">
    <div class="mx-auto max-w-7xl px-5 py-12 lg:px-8 lg:py-16">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h2 class="font-display text-3xl text-white">Ready to Partner With Us?</h2>
          <p class="mt-2 text-brand-200">
            Get in touch for a project-based quotation. We look forward to supporting your business.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-4">
          <a
            href={business.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-6 py-3 text-sm font-semibold text-white shadow-lg transition-all hover:bg-accent-600"
          >
            <Icon name="lucide:message-circle" class="size-5" />
            WhatsApp
          </a>
          <a
            href={contactUrl()}
            class="inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-white transition-all hover:bg-white/20"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
