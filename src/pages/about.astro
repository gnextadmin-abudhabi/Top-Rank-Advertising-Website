---
import MediaFrame from '../components/ui/MediaFrame.astro';
import aboutOffice from '../assets/images/about-office.webp';
import aboutPartnership from '../assets/images/about-partnership.webp';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import FeatureCard from '../components/ui/FeatureCard.astro';
import AreaCard from '../components/ui/AreaCard.astro';
import CtaBanner from '../components/ui/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { business } from '../data/business';
import { serviceAreas } from '../data/serviceAreas';
import { areaUrl, contactUrl } from '../lib/urls';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${business.website}/about/#webpage`,
      url: `${business.website}/about/`,
      name: `About ${business.name}`,
      description: `Learn about ${business.name}, a B2B printing and branding company based in Mussafah, Abu Dhabi.`,
      isPartOf: { '@id': `${business.website}/#website` },
      about: { '@id': `${business.website}/#business` },
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${business.website}/#business`,
      name: business.name,
      legalName: business.legalName,
      url: business.website,
      telephone: business.phone,
      email: business.email,
      description: business.description,
      address: {
        '@type': 'PostalAddress',
        streetAddress: business.address.street,
        addressLocality: business.address.city,
        addressRegion: business.address.state,
        addressCountry: 'AE',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: business.coordinates.lat,
        longitude: business.coordinates.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'],
          opens: '09:00',
          closes: '19:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: 'Friday',
          opens: '14:30',
          closes: '19:00',
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`About ${business.name} | B2B Printing & Branding Abu Dhabi`}
  description={`Learn about ${business.name}, a B2B printing and branding company based in Mussafah, Abu Dhabi. Serving corporate, retail, construction, and event clients across Abu Dhabi and Al Ain.`}
  schema={aboutSchema}
>
  <Breadcrumbs crumbs={[{ label: 'About' }]} />

  <!-- ============ HEADER ============ -->
  <Section tone="paper" size="sm">
    <SectionHeading
      eyebrow="Who we are"
      title={`About ${business.name}`}
      as="h1"
      size="page"
      align="left"
      max="max-w-3xl"
      subcopy="A dedicated B2B printing and branding partner for businesses across Abu Dhabi and Al Ain. From banners and stickers to complete corporate identity systems and custom acrylic fabrication."
    />
  </Section>

  <!-- ============ OUR STORY ============ -->
  <Section tone="plain" size="lg">
    <Reveal variant="up">
      <h2 class="font-display text-3xl leading-[1.12] tracking-tight text-brand-900 sm:text-4xl md:text-5xl">
        Our Story
      </h2>
    </Reveal>

    <!-- Prose and image are siblings in one stretched row, so the photo grows
         to match the text column instead of leaving dead space beside it. -->
    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <Reveal variant="up" delay={80} class="prose-editorial lg:col-span-7">
        <p>
          {business.name} was founded with a clear mission: to provide Abu Dhabi businesses with a reliable, end-to-end printing and branding partner that understands B2B needs. No retail queues, no one-size-fits-all templates, just professional service tailored to corporate, retail, construction, and event clients.
        </p>
        <p>
          Based in Mussafah Industrial Area, we operate from a fully equipped workshop with large-format eco-solvent printers, digital presses, CNC routers, laser cutters, and a skilled team of designers and fabricators. This means we control quality from design to delivery.
        </p>
        <p>
          Over the years, we have built lasting relationships with construction firms needing site hoardings, retail chains requiring consistent point-of-sale materials, event agencies launching product activations, and corporate offices updating their brand presence across multiple locations.
        </p>
        <p>
          Our approach is simple: understand your business, recommend the right materials and finishes, deliver on time, and stand behind every product we ship. That is why our clients come back project after project.
        </p>
      </Reveal>

      <Reveal variant="right" delay={160} class="lg:col-span-5">
        <MediaFrame
          src={aboutOffice}
          alt="Modern Abu Dhabi office interior featuring large-format printed wall graphics and branded environmental design by Top Rank Advertising"
          ratio="4/3"
          rounded="2xl"
          sizes="(min-width: 1024px) 40vw, 100vw"
          class="shadow-brand-md lg:aspect-auto lg:h-full"
        />
      </Reveal>
    </div>

    <!-- The company card runs full width, so its two paragraphs sit side by
         side rather than stacking into a tall, lopsided column. -->
    <Reveal variant="up" class="mt-12 block">
      <div class="rounded-3xl border border-stone-200 bg-stone-50 p-7 sm:p-9 md:p-10">
        <div class="flex flex-wrap items-center gap-4">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-brand-100 text-brand-700">
            <Icon name="lucide:building-2" class="size-7" />
          </span>
          <div>
            <h3 class="font-display text-xl tracking-tight text-brand-900 sm:text-2xl">
              {business.legalName}
            </h3>
            <p class="mt-0.5 text-sm text-stone-500">B2B Printing &amp; Branding</p>
          </div>
        </div>

        <div class="mt-8 grid gap-6 text-sm leading-relaxed text-stone-600 md:grid-cols-2 md:gap-10">
          <p>
            We specialize in eco-solvent banner printing, vinyl sticker production, corporate branding packages, and customized acrylic fabrication. Every project starts with a consultation and ends with a quality-checked delivery.
          </p>
          <p>
            Our team combines design expertise with industrial production capability, allowing us to handle everything from a single roll-up banner to a full fleet branding program for dozens of vehicles.
          </p>
        </div>

        <div class="mt-8 border-t border-stone-200 pt-6">
          <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-stone-500">
            Why B2B Clients Choose Us
          </p>
          <div class="mt-4 flex flex-wrap gap-2.5">
            {
              ['End-to-End Service', 'On-Time Delivery', 'Volume Pricing'].map((label) => (
                <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-medium text-brand-800 ring-1 ring-brand-500/20">
                  <Icon name="lucide:check-circle" class="size-4 text-accent-500" />
                  {label}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </Reveal>
  </Section>

  <!-- ============ TRUST SIGNALS ============ -->
  <Section tone="shade" size="lg">
    <SectionHeading eyebrow="Why us" title="Why Businesses Trust Us" align="center" />

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            icon: 'lucide:check-circle',
            title: 'End-to-End Service',
            detail:
              'From design and pre-press to printing, fabrication, and installation. One partner for your entire project.',
          },
          {
            icon: 'lucide:clock',
            title: 'On-Time Delivery',
            detail:
              'We commit to realistic timelines and communicate proactively if anything changes. Your deadlines matter.',
          },
          {
            icon: 'lucide:tags',
            title: 'B2B Volume Pricing',
            detail:
              'Larger orders and repeat clients benefit from tiered pricing. We help you maximize your marketing budget.',
          },
          {
            icon: 'lucide:shield-check',
            title: 'Quality Guaranteed',
            detail:
              'Every product is checked for color accuracy, structural integrity, and finish before it leaves our workshop.',
          },
        ].map((item, i) => (
          <FeatureCard
            icon={item.icon}
            title={item.title}
            detail={item.detail}
            delay={i * 80}
            class={i === 1 || i === 2 ? 'lg:translate-y-6' : ''}
          />
        ))
      }
    </div>

    <Reveal variant="clip" class="mt-14 block">
      <MediaFrame
        src={aboutPartnership}
        alt="Top Rank Advertising account manager shaking hands with B2B client during corporate branding consultation in Abu Dhabi"
        ratio="21/9"
        rounded="3xl"
        sizes="(min-width: 1280px) 80rem, 100vw"
        class="shadow-brand-lg"
      />
    </Reveal>
  </Section>

  <!-- ============ AREAS WE COVER ============ -->
  <Section tone="paper" size="lg">
    <SectionHeading
      eyebrow="Coverage"
      title="Areas We Serve"
      subcopy="We provide printing and branding services to businesses throughout Abu Dhabi and Al Ain."
      align="center"
    />
    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
      {
        serviceAreas.map((area, i) => (
          <AreaCard
            area={area}
            href={areaUrl(area.slug)}
            variant="mini"
            headingLevel="h3"
            showResponseTime={false}
            delay={Math.min(i, 5) * 60}
          />
        ))
      }
    </div>
  </Section>

  <!-- ============ CTA ============ -->
  <Section tone="deep" size="md">
    <CtaBanner
      title="Ready to Partner With Us?"
      body="Get in touch for a project-based quotation. We look forward to supporting your business."
      primary={{
        label: 'WhatsApp',
        href: business.whatsappHref,
        icon: 'lucide:message-circle',
        external: true,
      }}
      secondary={{ label: 'Contact Us', href: contactUrl() }}
    />
  </Section>
</BaseLayout>
