---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { blogUrl, contactUrl } from '../../lib/urls';
import { business } from '../../data/business';
import { Icon } from 'astro-icon/components';

import Reveal from '../../components/ui/Reveal.astro';
import CtaBanner from '../../components/ui/CtaBanner.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryColors: Record<string, { bg: string; text: string }> = {
  emergency: { bg: 'bg-red-100', text: 'text-red-700' },
  tips: { bg: 'bg-brand-100', text: 'text-brand-700' },
  maintenance: { bg: 'bg-amber-100', text: 'text-amber-700' },
  news: { bg: 'bg-stone-200', text: 'text-stone-700' },
  guides: { bg: 'bg-brand-100', text: 'text-brand-700' },
};

const colors = categoryColors[post.data.category] || categoryColors.news;

function formatDate(iso: string): string {
  const date = new Date(iso + 'T00:00:00');
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate,
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: business.website,
  },
  publisher: {
    '@type': 'Organization',
    name: business.name,
    url: business.website,
    telephone: business.phone,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `${business.website}${blogUrl(post.id)}`,
  },
};
---

<BaseLayout
  title={`${post.data.title} | ${business.name}`}
  description={post.data.description}
  canonicalUrl={`${business.website}${blogUrl(post.id)}`}
  schema={schema}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label: post.data.title },
    ]}
  />

  <article class="mx-auto max-w-[60rem] px-5 py-10 sm:px-6 md:px-8 lg:py-16">
    <Reveal variant="up" as="header" class="pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize ${colors.bg} ${colors.text}`}>
          {post.data.category}
        </span>
        {post.data.readingTime && (
          <span class="flex items-center gap-1 text-xs text-stone-400">
            <Icon name="lucide:clock" class="size-3" />
            {post.data.readingTime}
          </span>
        )}
      </div>

      <h1
        class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-brand-900 sm:text-5xl"
      >
        {post.data.title}
      </h1>

      <div class="mt-4 flex items-center gap-3 text-sm text-stone-500">
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="size-4" />
          <time datetime={post.data.publishDate}>
            {formatDate(post.data.publishDate)}
          </time>
        </div>
        <span class="text-stone-300">|</span>
        <div class="flex items-center gap-1.5">
          <Icon name="lucide:user" class="size-4" />
          <span>{post.data.author}</span>
        </div>
      </div>

      {post.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="rounded-full border border-stone-200 bg-stone-50 px-2.5 py-0.5 text-xs text-stone-500">
              {tag}
            </span>
          ))}
        </div>
      )}
    </Reveal>

    <Reveal variant="up" delay={120} class="prose-editorial block text-[1.125rem]">
      <Content />
    </Reveal>

    <div class="mt-14">
      <CtaBanner
        tone="panel"
        title="Need Printing or Branding Support?"
        body="If you have a project in mind or need expert advice on banners, stickers, branding, or acrylic fabrication, our team is ready to help. We serve businesses across Abu Dhabi and Al Ain."
        primary={{
          label: 'WhatsApp Us',
          href: business.whatsappHref,
          icon: 'lucide:message-circle',
          external: true,
        }}
        secondary={{ label: 'Request a Quotation', href: contactUrl(), icon: 'lucide:mail' }}
      />
    </div>
  </article>
  <div
    class="fixed inset-x-0 top-16 z-40 h-0.5 origin-left scale-x-0 bg-accent-500"
    id="read-progress"
    aria-hidden="true"
  >
  </div>

  <script>
    const bar = document.getElementById('read-progress');
    const article = document.querySelector('article');
    if (bar && article) {
      const update = () => {
        const start = article.offsetTop;
        const span = article.offsetHeight - window.innerHeight;
        if (span <= 0) return;
        const p = Math.min(Math.max((window.scrollY - start) / span, 0), 1);
        bar.style.transform = `scaleX(${p})`;
      };
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
  </script>
</BaseLayout>
